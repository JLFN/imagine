# Environment for the command-line client and the agent tool server.
#
# Copy this file to .env, fill in what applies, and keep .env out of version
# control (it is already ignored). Never commit a real key.

# Where the client sends requests. Include the version segment.
# Default: http://127.0.0.1:8787/v1
IMAGEGEN_BASE_URL=http://127.0.0.1:8787/v1

# Bearer token, when the endpoint requires one. The bundled bridge does not
# check credentials, so this stays empty for a local deployment.
IMAGEGEN_API_KEY=

# Total request timeout in seconds. A large image at a high step count can take
# several minutes.
IMAGEGEN_TIMEOUT_SECS=300

# Bridge settings, when the service and the client run from different files.
# These override imagegen.toml for the bridge process.
# IMAGEGEN_CONFIG=imagegen.local.toml
# IMAGEGEN_SD_SERVER=bin/sd-server
# IMAGEGEN_DIFFUSION=models/diffusion_models/qwen-image-2.1-Q6_K.gguf
# IMAGEGEN_VAE=models/vae/qwen_image_2.1_vae_bf16.safetensors
# IMAGEGEN_LLM=models/text_encoders/Qwen3VL-8B-Instruct-Q4_K_M.gguf
# IMAGEGEN_LISTEN_IP=127.0.0.1
# IMAGEGEN_LISTEN_PORT=8787
# IMAGEGEN_BACKEND_PORT=8788
# IMAGEGEN_STEPS=28
# IMAGEGEN_CFG_SCALE=6.0
