+// The convrot rotation the patched ggml applies to activations before an int8
+// matmul. Copied from ggml_regular_hadamard_group_f32 in
+// ggml/src/ggml-cpu/ggml-cpu.c so the host can reproduce it exactly. It is the
+// normalized regular Hadamard built from H4, so it is its own inverse: applying
+// it once more undoes the offline rotation the quantizer baked into the weights.
+static void regular_hadamard_group_f32(float* values, int group_size) {
+    const float scale = 1.0f / sqrtf((float)group_size);
+    for (int i = 0; i < group_size; ++i) {
+        values[i] *= scale;
+    }
+
+    for (int stride = 1; stride < group_size; stride *= 4) {
+        for (int base = 0; base < group_size; base += 4 * stride) {
+            for (int j = 0; j < stride; ++j) {
+                const int i0 = base + j;
+                const int i1 = i0 + stride;
+                const int i2 = i1 + stride;
+                const int i3 = i2 + stride;
+                const float a = values[i0];
+                const float b = values[i1];
+                const float c = values[i2];
+                const float d = values[i3];
+                values[i0] =  a + b + c - d;
+                values[i1] =  a + b - c + d;
+                values[i2] =  a - b + c + d;
+                values[i3] = -a + b + c + d;
+            }
+        }
+    }
+}
+
+// Dequantize an int8_tensorwise weight into a float destination.
+//
+// int8_tensorwise weights are normally consumed in place by the int8 matmul path
+// (ggml_ext_linear_i8_tensorwise), which is why the generic converter refuses
+// them: GGML_TYPE_I8 has no to_float trait, so nothing can dequantize one.
+// Blocks that cannot use that path and need a float tensor instead - the token
+// embedding, which is a gather rather than a matmul - reach this function with
+// their per-row scales already read from the file. The convrot rotation is undone
+// because the graph expects the true values: the rotation lives in the weights
+// and is meant to be cancelled by the rotation the runtime applies to the
+// activations of a quantized linear, which does not happen for a lookup that then
+// passes through a learned-weight normalization.
+static void dequantize_int8_tensorwise(const int8_t* src,
+                                       const float*  row_scales,
+                                       void*         dst,
+                                       ggml_type     dst_type,
+                                       int64_t       nrows,
+                                       int64_t       ncols,
+                                       int           convrot_group_size) {
+    std::vector<float> row((size_t)ncols);
+    for (int64_t r = 0; r < nrows; ++r) {
+        const int8_t* qrow = src + r * ncols;
+        const float s      = row_scales != nullptr ? row_scales[r] : 1.0f;
+        for (int64_t i = 0; i < ncols; ++i) {
+            row[(size_t)i] = (float)qrow[i] * s;
+        }
+        if (convrot_group_size > 0) {
+            for (int64_t g = 0; g + convrot_group_size <= ncols; g += convrot_group_size) {
+                regular_hadamard_group_f32(row.data() + g, convrot_group_size);
+            }
+        }
+        if (dst_type == GGML_TYPE_F32) {
+            memcpy((float*)dst + r * ncols, row.data(), (size_t)ncols * sizeof(float));
+        } else {
+            ggml_fp32_to_fp16_row(row.data(), (ggml_fp16_t*)dst + r * ncols, (int)ncols);
+        }
+    }
+}
